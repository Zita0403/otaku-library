<%- include("../partials/header.ejs") %>
<h2 class="genre-title">Category: <%= title %></h2>
<div class="filter-container">
    <img src="/webfonts/sliders-solid-full.svg" alt="Filter">
<select name="sortGenre" id="sortGenre">
        <option value="/genre/<%= genreId %>/<%= genreName %>?sort=-averageRating" <%= currentSort === '-averageRating' ? 'selected' : '' %>>Rating: High to Low</option>
        <option value="/genre/<%= genreId %>/<%= genreName %>?sort=averageRating" <%= currentSort === 'averageRating' ? 'selected' : '' %>>Rating: Low to High</option>
        <option value="/genre/<%= genreId %>/<%= genreName %>?sort=-startDate" <%= currentSort === '-startDate' ? 'selected' : '' %>>Release Date: Newest</option>
        <option value="/genre/<%= genreId %>/<%= genreName %>?sort=startDate" <%= currentSort === 'startDate' ? 'selected' : '' %>>Release Date: Oldest</option>
        <option value="/genre/<%= genreId %>/<%= genreName %>?sort=canonicalTitle" <%= currentSort === 'canonicalTitle' ? 'selected' : '' %>>Title: A - Z</option>
        <option value="/genre/<%= genreId %>/<%= genreName %>?sort=-canonicalTitle" <%= currentSort === '-canonicalTitle' ? 'selected' : '' %>>Title: Z - A</option>
    </select>
</div>
<div class="content">
    <% if (locals.error && error) { %>
        <div class="api-error-box">
            <p><%= error %></p>
        </div>
    <% } else if (animeList && animeList.length > 0) { %>
        <% animeList.forEach(anime => { %>
            <div class="anime-card">
                <a href="/anime/<%= anime.mal_id %>">
                    <div class="card-image-wrapper">
                        <img src="<%= anime.images.jpg.large_image_url %>" alt="<%= anime.title %>">
                    </div>
                    <div class="card-body">
                        <h5><%= anime.title %></h5>
                        <p><i class="fa-solid fa-star"></i> <%= anime.score %></p>
                        <p>Age Rating: <%= anime.age_rating %></p>
                        <p>Year & Season: <%= anime.seasonYearText || (anime.startDate ? anime.startDate.substring(0, 4) : 'N/A') %></p>
                    </div>
                </a>
            </div>
        <% }); %>
    <% } else { %>
        <p>No anime found in this category.</p>
    <% } %>
</div>
<% if (!locals.error || !error) { %>
    <div class="pagination">
        <% 
            const finalBaseUrl = (locals.type === 'search') 
                ? `/search?q=${encodeURIComponent(searchQuery)}&` 
                : (locals.baseUrl || `/genre/${genreId}/${genreName}?sort=${currentSort}&`);
        %>
        <% if (currentPage > 1) { %>
            <a href="<%= finalBaseUrl %>page=1" class="btn">«</a>
            <a href="<%= finalBaseUrl %>page=<%= currentPage - 1 %>" class="btn">‹</a>
        <% } %>
        <% 
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(lastPage, startPage + 4); 
            if (endPage - startPage < 4) {
                startPage = Math.max(1, endPage - 4);
            }
        %>
        <% for(let i = startPage; i <= endPage; i++) { %>
                <a href="<%= finalBaseUrl %>page=<%= i %>" 
                class="page-num <%= i === currentPage ? 'active' : '' %>">
                    <%= i %>
                </a>
        <% } %>
        <% if (hasNextPage) { %>
            <a href="<%= finalBaseUrl %>page=<%= currentPage + 1 %>" class="btn">›</a>
            <a href="<%= finalBaseUrl %>page=<%= lastPage %>" class="btn">»</a>
        <% } %>
    </div>
<% } %>
<%- include("../partials/footer.ejs") %>